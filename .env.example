# Required for real AI answers. Without this, the AI Advisor endpoint
# returns a clearly-labeled demo response so the app still runs end-to-end.
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI Advisor route.
# Check current model names at https://docs.claude.com before deploying.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Placeholder for when the Postgres/Neon backend is wired up (Developer 2).
# Not required for the current in-browser demo (localStorage-backed).
DATABASE_URL=
