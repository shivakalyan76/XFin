# AI Provider selection: 'gemini' (current), 'demo', or 'lyra' (future)
AI_PROVIDER=gemini

# Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Supported Gemini model (e.g. gemini-3.5-flash-lite, gemini-3.5-flash, gemini-flash-latest, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database URL (optional - for future Postgres/Neon backend)
DATABASE_URL=
